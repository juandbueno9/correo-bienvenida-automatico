<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.empresa.bienvenida</string>

    <key>ProgramArguments</key>
    <array>
        <string>/ruta/al/proyecto/venv/bin/python</string>
        <string>/ruta/al/proyecto/enviar_bienvenida.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/ruta/al/proyecto</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/ruta/al/proyecto/log.txt</string>
    <key>StandardErrorPath</key>
    <string>/ruta/al/proyecto/log.txt</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
